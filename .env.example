# LIFE PostgreSQL migration configuration.
# Copy to .env (gitignored); fill DSN locally or inject it through a secret.
# Migration and runtime loaders each consume only their documented keys.

# Set true after configuring DSN to migrate automatically on every service startup.
# Startup waits for success; applied versions are verified and skipped on restart.
# Keep false only when migrations are disabled or managed by a separate release Job.
LIFE_AUTO_MIGRATE=false

# Migration role URL, not the runtime/recorder role; credentials must be URL-encoded.
LIFE_MIGRATION_DSN=

# Relative paths resolve against this file's directory. Empty uses bundled defaults.
LIFE_MIGRATION_DIRECTORY=migrations/life_liquidity
LIFE_MIGRATION_SSL_CA_FILE=

# TLS verification is default; true is accepted only for literal loopback test DBs.
LIFE_MIGRATION_LOCAL_INSECURE=false

# Migration operation defaults, not live trading thresholds.
LIFE_MIGRATION_LOCK_TIMEOUT_SECONDS=10
LIFE_MIGRATION_STATEMENT_TIMEOUT_MS=30000
LIFE_MIGRATION_DDL_LOCK_TIMEOUT_MS=5000

# PG2 pool infrastructure only: these settings do not enable the trading backend.
# Account ID, complete StateBinding and expected database lineage come from the
# approved service/import configuration, never from an implicit account default.
# Use an existing least-privilege login provisioned by the migration/import owner.
LIFE_PG_DSN=
LIFE_PG_PRINCIPAL=
LIFE_PG_ACCESS=runtime
LIFE_PG_LOCAL_INSECURE=false
LIFE_PG_SSL_CA_FILE=
LIFE_PG_SERVER_MAJOR=16

# Synthetic local qualification values; calibrate deployment bounds before use.
LIFE_PG_POOL_MIN_SIZE=1
LIFE_PG_POOL_MAX_SIZE=2
LIFE_PG_MAX_PENDING=4
LIFE_PG_SAFETY_POOL_SIZE=1
LIFE_PG_SAFETY_MAX_PENDING=2
LIFE_PG_ACQUIRE_TIMEOUT_MS=1000
LIFE_PG_STATEMENT_TIMEOUT_MS=1000
LIFE_PG_TRANSACTION_TIMEOUT_MS=3000
LIFE_PG_IDLE_TRANSACTION_TIMEOUT_MS=4000
LIFE_PG_SHUTDOWN_TIMEOUT_MS=2000
LIFE_PG_RETRY_COUNT=2
LIFE_PG_RETRY_BASE_MS=10
