# Local settings only. Cloud Run injects these values directly (secrets through Secret Manager).
# Swagger routes require ENV=dev/development (case-insensitive). Default: dev.
# Use ENV=production in deployed production services to hide UI, schema and assets.
ENV=dev
# Warn when a running session has no observed working quotes continuously for this many seconds.
# Monitoring only; 0 disables the warning. Gaps/restart reset the observation window.
MM_NO_QUOTE_WARNING_SECONDS=120
# Select postgres, or file for the original local SQLite/JSON runtime (hbot start).
STORAGE_BACKEND=postgres
# ENV_FILE selects a local dotenv file from the process environment; default: repo-root .env.
DATABASE_URL=postgresql+psycopg2://hummingbot:replace_me@127.0.0.1:5432/hummingbot
# Total PostgreSQL connection ceiling per service instance (5–50); no overflow.
# API reserves 2; engine uses the remainder. Restart the whole service after changes.
# Budget all instances/revisions plus temporary migration engines.
DB_POOL_SIZE=5
# Explicitly enable startup DDL here; the code default when omitted is false.
ENABLE_AUTO_MIGRATION=true
BOT_ID=hummingbot
PORT=8080
# Foreground service console logging. DEBUG includes detailed connector diagnostics.
# Allowed levels: DEBUG, INFO, WARNING, ERROR, CRITICAL; format: json or text.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Admin endpoints, Swagger schema and UI share Basic Auth. No usable credential defaults.
ADMIN_API_ENABLED=false
ADMIN_API_USERNAME=
ADMIN_API_PASSWORD=
# * allows any FE origin; send Authorization explicitly with fetch credentials: "omit".
ADMIN_CORS_ORIGINS=*
# Read-only daily cache TTL (maximum 60s); 0 also disables last-good fallback.
# Transient refresh failures may return explicitly stale observations younger than 60s.
ADMIN_STATISTICS_CACHE_TTL_SECONDS=5
# Owner service funding observation cadence, including stopped/expired sessions.
FUNDING_SYNC_INTERVAL_SECONDS=120
REPORTING_TIMEZONE=Asia/Ho_Chi_Minh
# Process-level exchange routing, independent of spot/perpetual/both selection.
OKX_TRADING_ENV=live
OKX_SITE=www
# Live credentials below are never used when OKX_TRADING_ENV=demo.
HBOT_OKX_API_KEY=replace_me
HBOT_OKX_SECRET_KEY=replace_me
HBOT_OKX_PASSPHRASE=replace_me
HBOT_OKX_REGISTRATION_SUB_DOMAIN=www
# Dedicated Demo keys; populate only from an OKX Demo account, not live keys.
HBOT_OKX_DEMO_API_KEY=
HBOT_OKX_DEMO_SECRET_KEY=
HBOT_OKX_DEMO_PASSPHRASE=
HBOT_OKX_PERPETUAL_DEMO_API_KEY=
HBOT_OKX_PERPETUAL_DEMO_SECRET_KEY=
HBOT_OKX_PERPETUAL_DEMO_PASSPHRASE=
