# Copy outside the repository, fill credentials, chmod 600, then use --env-file.
# Cloud Run injects these names directly; do not set ENV_FILE/HBOT_ENV_FILE there.
ENV=dev
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg2://hummingbot:replace_me@host.docker.internal:5432/hummingbot_demo
ENABLE_AUTO_MIGRATION=true
DB_POOL_SIZE=5
BOT_ID=hummingbot-demo
PORT=8080
LOG_FORMAT=json
LOG_LEVEL=INFO
ADMIN_API_ENABLED=true
ADMIN_API_USERNAME=demo-admin
ADMIN_API_PASSWORD=
ADMIN_CORS_ORIGINS=*
ADMIN_STATISTICS_CACHE_TTL_SECONDS=5
FUNDING_SYNC_INTERVAL_SECONDS=120
# Daily reporting buckets only; database timestamps remain UTC.
REPORTING_TIMEZONE=Asia/Ho_Chi_Minh
OKX_TRADING_ENV=demo
OKX_SITE=www
# Supply keys created in OKX Demo. No live credentials belong in this preset.
HBOT_OKX_DEMO_API_KEY=
HBOT_OKX_DEMO_SECRET_KEY=
HBOT_OKX_DEMO_PASSPHRASE=
HBOT_OKX_PERPETUAL_DEMO_API_KEY=
HBOT_OKX_PERPETUAL_DEMO_SECRET_KEY=
HBOT_OKX_PERPETUAL_DEMO_PASSPHRASE=
