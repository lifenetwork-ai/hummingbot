{
  "name": "lifeai-fe-starter",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm run theme:generate && vite",
    "build": "pnpm run theme:generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "theme:generate": "tsx scripts/generate-theme.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:visual": "cross-env VISUAL_BASELINES_READY=1 playwright test e2e/visual.spec.ts",
    "test:visual:update": "cross-env VISUAL_BASELINES_READY=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "skills:check": "node scripts/validate-skills.mjs",
    "skills:scaffold": "node scripts/scaffold-feature.mjs",
    "skills:sync:claude": "node scripts/sync-claude-skills.mjs",
    "api:generate": "node --import tsx scripts/generate-api.ts",
    "api:check": "node --import tsx scripts/generate-api.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-router": "^1.95.5",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.17",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "openapi-typescript": "7.10.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
